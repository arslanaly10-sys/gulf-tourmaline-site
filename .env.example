# Anthropic API key for the assistant (set in Vercel project settings, never commit it)
ANTHROPIC_API_KEY=
# Password for the staff review screen at /staff
STAFF_PASSWORD=
# Set automatically when a Vercel Blob store is connected; without it requests are stored in .data/ locally
BLOB_READ_WRITE_TOKEN=
# Email via Resend (optional; without it, notifications are skipped and logged on each request)
RESEND_API_KEY=
# Comma-separated sales addresses that receive new-request alerts
NOTIFY_TO=
# Sender on a domain verified in Resend, e.g. "GTT Quotations <quotes@algte.com>"
MAIL_FROM=
# Public site address used in email links (defaults to the Vercel production URL)
SITE_URL=
# VAT registration number printed on quotations (optional)
QUOTE_VAT_NUMBER=
